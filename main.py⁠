def get_user_id(update: Update) -> int | None:
    """Получить ID пользователя."""
    return update.effective_user.id if update.effective_user else None


def reset_input_state(context: ContextTypes.DEFAULT_TYPE) -> None:
    """Сбросить любой ожидающий ввод и черновик."""
    context.user_data["mode"] = None
    for key in (
        "schedule_day",
        "draft_task",
        "task_action",
        "selected_task_id",
    ):
        context.user_data.pop(key, None)


def cancel_ai_task(user_id: int | None) -> None:
    """Отменить незавершённый запрос ИИ пользователя."""
    if user_id is None:
        return

    task = ai_tasks_by_user.pop(user_id, None)
    if task and not task.done():
        task.cancel()


def reset_user_state(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Сбросить состояние пользователя и его активный запрос ИИ."""
    cancel_ai_task(get_user_id(update))
    reset_input_state(context)


