def run_keep_alive_server(port: int) -> None:
    """Запустить лёгкий веб-сервер в отдельном потоке."""
    try:
        web_app.run(
            host="0.0.0.0",
            port=port,
            debug=False,
            use_reloader=False,
        )
    except Exception:
        logger.exception("Keep-alive веб-сервер остановился с ошибкой")


def start_keep_alive_server() -> None:
    """Запустить keep-alive сервер и вывести предоставленный Replit URL."""
    port = int(os.getenv("PORT", "5000"))
    server_thread = threading.Thread(
        target=run_keep_alive_server,
        args=(port,),
        name="keep-alive-server",
        daemon=True,
    )
    server_thread.start()

    dev_domain = os.getenv("REPLIT_DEV_DOMAIN", "").strip()
    if dev_domain:
        dev_domain = dev_domain.removeprefix("https://").removeprefix("http://")
        server_url = f"https://{dev_domain.rstrip('/')}"
    else:
        server_url = f"http://0.0.0.0:{port}"
    print(f"Web server URL: {server_url}", flush=True)


