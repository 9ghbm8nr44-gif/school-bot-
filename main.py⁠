async def handle_callback(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    """Обработать inline-кнопки задач, расписания и добавления."""
    query = update.callback_query
    if not query:
        return

    try:
        await query.answer()
        data = query.data or ""
        user_id = get_user_id(update)
        if user_id is None:
            raise ValueError("Не найден пользователь")

        if data.startswith("task_subject:"):
            subject = data.removeprefix("task_subject:")
            if subject == "custom":
                context.user_data["mode"] = "add_task_subject"
                context.user_data["draft_task"] = {}
                await query.edit_message_text(
                    "✍️ Введите название предмета одним сообщением."
                )
                return
            if subject not in TASK_SUBJECTS:
                raise ValueError("Неизвестный предмет")

            context.user_data["draft_task"] = {"subject": subject}
            context.user_data["mode"] = "add_task_title"
            await query.edit_message_text(
                f"Выбран предмет: {subject}\n\n"
                "📝 Теперь введите название задания."
            )
            return

        if data == "schedule:edit":
            reset_user_state(update, context)
            context.user_data["mode"] = "choose_schedule_day"
            await query.edit_message_text(
                "Выберите день недели для редактирования:",
                reply_markup=weekdays_keyboard(),
            )
            return

        if data.startswith("schedule:day:"):
            day = data.removeprefix("schedule:day:")
            if day not in WEEKDAYS:
                raise ValueError("Неизвестный день")
            reset_user_state(update, context)
            context.user_data["mode"] = "add_schedule"
            context.user_data["schedule_day"] = day
            await query.edit_message_text(
                f"Введите список уроков на {day} одним сообщением.\n"
                "Например: «1. Алгебра 2. Физика 3. Геометрия»."
            )
            return

        if data.startswith("task_action:"):
            action = data.removeprefix("task_action:")
            if action not in TASK_ACTIONS:
                raise ValueError("Неизвестное действие с задачей")
            if not active_tasks(user_id):
                await query.edit_message_text(
                    tasks_text(user_id),
                )
                reset_input_state(context)
                return

            cancel_ai_task(user_id)
            reset_input_state(context)
            context.user_data["mode"] = "task_select_action"
            context.user_data["task_action"] = action
            await query.edit_message_text(
                f"{TASK_ACTIONS[action]}\n\nВыберите задачу:",
                reply_markup=task_selection_keyboard(user_id, action),
            )
            return

        if data.startswith("task_select:"):
            parts = data.split(":")
            if len(parts) != 3:
                raise ValueError("Некорректная задача")
            action, raw_task_id = parts[1], parts[2]
            if action not in TASK_ACTIONS:
                raise ValueError("Неизвестное действие")
            task = find_task(user_id, int(raw_task_id))
            if task is None or task.get("completed"):
                raise ValueError("Задача не найдена")

            if action == "complete":
                task["completed"] = True
                reset_input_state(context)
                await query.edit_message_text(
                    "✅ Задача выполнена!\n\n" + tasks_text(user_id),
                    reply_markup=(
                        task_actions_keyboard()
                        if active_tasks(user_id)
                        else None
                    ),
                )
                return

            if action == "delete":
                tasks_by_user[user_id].remove(task)
                reset_input_state(context)
                await query.edit_message_text(
                    "🗑️ Задача удалена.\n\n" + tasks_text(user_id),
                    reply_markup=(
                        task_actions_keyboard()
                        if active_tasks(user_id)
                        else None
                    ),
                )
                return

            context.user_data.pop("task_action", None)
            context.user_data["selected_task_id"] = int(raw_task_id)
            if action == "edit":
                context.user_data["mode"] = "edit_task_title"
                await query.edit_message_text(
                    "✏️ Введите новое название задания."
                )
            else:
                context.user_data["mode"] = "move_task_date"
                await query.edit_message_text(
                    "📅 Введите новую дату в формате ДД.ММ.ГГГГ."
                )
            return
    except Exception:
        logger.exception("Ошибка при обработке inline-кнопки")
        reset_user_state(update, context)
        if query.message:
            await query.message.reply_text(
                INVALID_INPUT_TEXT,
                reply_markup=MENU,
            )


def clean_text(text: str) -> str:
    """Очистить любой ответ ИИ от системной разметки и технического мусора."""
    if not text:
        return ""

    text = str(text)

    # Убираем системные XML/HTML-теги, включая многострочные служебные блоки.
    text = re.sub(
        r"<ElicitationsGroup[\s\S]*?</ElicitationsGroup>",
        "",
        text,
        flags=re.IGNORECASE,
    )
    text = re.sub(
        r"<Elicitation\b[\s\S]*?</Elicitation>",
        "",
        text,
        flags=re.IGNORECASE,
    )
    text = re.sub(
        r"<Elicitation[\s\S]*?>",
        "",
        text,
        flags=re.IGNORECASE,
    )
    text = re.sub(r"<[^>]+>", "", text)

    # Убираем LaTeX и мусорные символы индексов.
    text = text.replace('_{{', '_').replace('}}', '').replace('{', '').replace('}', '')
    text = (
        text.replace("\\times", "*")
        .replace("\\div", "/")
        .replace("\\pm", "+/-")
        .replace("\\le", "<=")
        .replace("\\ge", ">=")
        .replace("\\neq", "!=")
        .replace("\\text", "")
        .replace("\\(", "")
        .replace("\\)", "")
        .replace("\\[", "")
        .replace("\\]", "")
        .replace("```", "")
    )
    text = re.sub(
        r"\\left|\\right|<=ft|right\)",
        "",
        text,
        flags=re.IGNORECASE,
    )
    text = text.replace('$', '').replace('\\cdot', '*').replace('\\frac', '').replace('\\', '')

    # Убираем известные технические маркеры, которые иногда возвращают провайдеры.
    text = re.sub(r"\bU\+?[0-9A-F]{5,}\b", "", text, flags=re.IGNORECASE)
    text = re.sub(r"\b0x[0-9A-F]{5,}\b", "", text, flags=re.IGNORECASE)
    text = re.sub(
        r"(?im)^\s*(?:retryprovidererror|responseerror|"
        r"novalidharfileerror|traceback|stack trace)\b.*$",
        "",
        text,
    )

    # Убираем двойные пробелы и лишние пустые строки, сохраняя переносы.
    text = re.sub(r"[ \t]{2,}", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


def is_ai_error_text(text: str) -> bool:
    """Распознать пустой ответ или типичное английское сообщение об ошибке."""
    normalized = text.strip().lower()
    if not normalized:
        return True

    error_markers = (
        "error",
        "exception",
        "failed to",
        "request failed",
        "internal server",
        "service unavailable",
        "timed out",
        "timeout",
        "rate limit",
        "unauthorized",
        "forbidden",
        "bad gateway",
        "gateway timeout",
    )
    return any(marker in normalized for marker in error_markers)


async def ask_g4f(
    question: str,
    system_prompt: str = AI_SYSTEM_PROMPT,
) -> str:
    """Получить лаконичный ответ через g4f с повторными попытками."""
    def get_response() -> str:
        client = Client(provider=Provider.Gemini)
        response = client.chat.completions.create(
            model="gemini-3.6-flash",
            messages=[
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": question},
            ],
        )
        return response.choices[0].message.content or ""

    last_error: Exception | None = None
    for attempt in range(3):
        try:
            answer = clean_text(await asyncio.to_thread(get_response))
            if is_ai_error_text(answer):
                raise RuntimeError("ИИ вернул пустой ответ или сообщение об ошибке")
            return answer
        except asyncio.CancelledError:
            raise
        except Exception as error:
            last_error = error
            if attempt < 2:
                logger.warning(
                    "Повтор запроса ИИ: попытка %s из 3 для текущего запроса",
                    attempt + 2,
                )
                await asyncio.sleep(1)

    raise RuntimeError("Не удалось получить ответ от ИИ") from last_error


def extract_text_from_photo(photo_path: str) -> str:
    """Распознать текст с локального фото на русском и английском."""
    with Image.open(photo_path) as image:
        prepared_image = ImageOps.exif_transpose(image)
        if prepared_image.mode != "RGB":
            prepared_image = prepared_image.convert("RGB")

        scale = 2 if max(prepared_image.size) < 2200 else 1
        if scale > 1:
            prepared_image = prepared_image.resize(
                (
                    prepared_image.width * scale,
                    prepared_image.height * scale,
                ),
                Image.Resampling.LANCZOS,
            )

        return pytesseract.image_to_string(
            prepared_image,
            lang="rus+eng",
            config="--oem 3 --psm 6",
        ).strip()


async def send_long_message(update: Update, text: str) -> None:
    """Отправить длинный ответ несколькими сообщениями."""
    if not update.message:
        return
    text = clean_text(text)
    if not text:
        return
    for start_index in range(0, len(text), 4000):
        await update.message.reply_text(text[start_index : start_index + 4000])


async def send_error_message(update: Update, text: str) -> None:
    """Сообщить пользователю об ошибке и показать главное меню."""
    if not update.message:
        return
    try:
        await update.message.reply_text(text, reply_markup=MENU)
    except Exception:
        logger.exception("Не удалось отправить сообщение об ошибке")


async def process_ai_request(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
    question: str,
    user_id: int,
) -> None:
    """Выполнить запрос ИИ с повторами, таймаутом и защитой от зависания."""
    current_task = asyncio.current_task()
    try:
        answer = await asyncio.wait_for(ask_g4f(question), timeout=20)
        answer = clean_text(answer)
        if not answer:
            raise RuntimeError("ИИ вернул пустой ответ")
        await send_long_message(update, answer)
    except asyncio.CancelledError:
        logger.info("Запрос ИИ отменён пользователем %s", user_id)
        raise
    except asyncio.TimeoutError:
        logger.warning("Запрос ИИ превысил таймаут для пользователя %s", user_id)
        reset_input_state(context)
        if update.message:
            await update.message.reply_text(AI_ERROR_TEXT, reply_markup=MENU)
    except Exception:
        logger.exception("Ошибка запроса ИИ для пользователя %s", user_id)
        reset_input_state(context)
        if update.message:
            await update.message.reply_text(AI_ERROR_TEXT, reply_markup=MENU)
    finally:
        if ai_tasks_by_user.get(user_id) is current_task:
            ai_tasks_by_user.pop(user_id, None)


async def process_photo_request(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
    photo_id: str,
    user_id: int,
) -> None:
    """Скачать фото, распознать текст и решить его обычным g4f-запросом."""
    current_task = asyncio.current_task()
    temp_path: str | None = None
    try:
        telegram_file = await context.bot.get_file(photo_id)
        file_descriptor, temp_path = tempfile.mkstemp(
            prefix="telegram_photo_",
            suffix=".jpg",
        )
        os.close(file_descriptor)
        await telegram_file.download_to_drive(custom_path=temp_path)

        with open(temp_path, "rb") as photo_file:
            image_data = photo_file.read()
        ocr_text = await asyncio.wait_for(
            asyncio.to_thread(extract_text_from_photo, temp_path),
            timeout=20,
        )
        ocr_text = ocr_text.strip()
        if len(ocr_text) < 4:
            reset_input_state(context)
            if update.message:
                await update.message.reply_text(
                    PHOTO_ERROR_TEXT,
                    reply_markup=MENU,
                )
            return

        answer = await asyncio.wait_for(
            ask_g4f(ocr_text, system_prompt=PHOTO_OCR_SYSTEM_PROMPT),
            timeout=20,
        )
        answer = clean_text(answer)
        if not answer:
            raise RuntimeError("ИИ вернул пустой ответ для фото")
        await send_long_message(update, answer)
    except asyncio.CancelledError:
        logger.info("Обработка фото отменена пользователем %s", user_id)
        raise
    except Exception:
        logger.exception("Ошибка обработки фото для пользователя %s", user_id)
        reset_input_state(context)
        if update.message:
            await update.message.reply_text(PHOTO_ERROR_TEXT, reply_markup=MENU)
    finally:
        if temp_path:
            try:
                os.remove(temp_path)
            except FileNotFoundError:
                pass
            except OSError:
                logger.exception("Не удалось удалить временный файл фото")
        if ai_tasks_by_user.get(user_id) is current_task:
            ai_tasks_by_user.pop(user_id, None)


