async def handle_text_safely(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    if not update.message or update.message.text is None:
        return

    message_text = update.message.text.strip()
    user_id = get_user_id(update)
    mode = context.user_data.get("mode")

    # Защита для тестов и нестандартных обновлений: в приложении этот текст
    # перехватывается первым зарегистрированным MessageHandler.
    if message_text == BACK_BUTTON:
        await handle_back_to_menu(update, context)
        return

    if message_text == "📋 Задачи":
        await show_tasks_menu(update, context)
        return
    if message_text in {"📋 Задачи на сегодня", "📝 Задачи на сегодня"}:
        await show_tasks(update, context)
        return
    if message_text == "➕ Добавить задачу":
        await ask_for_task(update, context)
        return

    if message_text == "📚 Расписание уроков":
        await show_schedule_menu(update, context)
        return
    if message_text == "📅 Расписание уроков":
        await show_schedule_menu(update, context)
        return
    if message_text == "📅 Сегодня":
        reset_user_state(update, context)
        if user_id is not None:
            await send_schedule_view(
                update,
                schedule_day_text(user_id, 0),
                context,
            )
        return
    if message_text == "📆 Завтра":
        reset_user_state(update, context)
        if user_id is not None:
            await send_schedule_view(
                update,
                schedule_day_text(user_id, 1),
                context,
            )
        return
    if message_text == "🗓️ Вся неделя":
        reset_user_state(update, context)
        if user_id is not None:
            await send_schedule_view(update, schedule_text(user_id), context)
        return
    if message_text == "✏️ Изменить расписание":
        await show_schedule_editor(update, context)
        return

    if message_text == "🤖 ИИ-Решебник задач":
        reset_user_state(update, context)
        context.user_data["mode"] = "solve"
        if update.message:
            await update.message.reply_text(
                "🤖 ИИ-Решебник\n"
                "Отправь мне условие задачи или вопрос по любому предмету. "
                "Чтобы выйти из режима — нажми кнопку ниже.",
                reply_markup=SUBMENU_MENU,
            )
        return

    if message_text == "📸 Решить по фото":
        reset_user_state(update, context)
        context.user_data["mode"] = "solve_photo"
        if update.message:
            await update.message.reply_text(
                "📸 Отправь фотографию с условием задачи.",
                reply_markup=SUBMENU_MENU,
            )
        return

    if user_id is None:
        raise ValueError("Не найден пользователь")

    if mode == "add_task_subject":
        if not message_text:
            await reply_invalid(update, TASKS_MENU)
            return
        context.user_data.setdefault("draft_task", {})["subject"] = message_text
        context.user_data["mode"] = "add_task_title"
        await update.message.reply_text(
            "📝 Введите название задания.",
            reply_markup=TASKS_MENU,
        )
        return

    if mode == "add_task_title":
        if not message_text:
            await reply_invalid(update, TASKS_MENU)
            return
        context.user_data.setdefault("draft_task", {})["title"] = message_text
        context.user_data["mode"] = "add_task_date"
        await update.message.reply_text(
            "📅 Введите дату в формате ДД.ММ.ГГГГ.\n"
            "Можно также написать «сегодня» или «завтра».",
            reply_markup=TASKS_MENU,
        )
        return

    if mode == "add_task_date":
        parsed_date = parse_task_date(message_text)
        if not parsed_date:
            await reply_invalid(update, TASKS_MENU)
            return
        context.user_data.setdefault("draft_task", {})["date"] = parsed_date
        context.user_data["mode"] = "add_task_deadline"
        await update.message.reply_text(
            "⏰ Введите дедлайн в формате ЧЧ:ММ, например 18:30.",
            reply_markup=TASKS_MENU,
        )
        return

    if mode == "add_task_deadline":
        deadline = parse_deadline(message_text)
        if not deadline:
            await reply_invalid(update, TASKS_MENU)
            return
        context.user_data.setdefault("draft_task", {})["deadline"] = deadline
        context.user_data["mode"] = "add_task_reminder"
        await update.message.reply_text(
            "🔔 Настроить напоминание?",
            reply_markup=REMINDER_MENU,
        )
        return

    if mode == "add_task_reminder":
        reminder_values = {
            "✅ Да": True,
            "❌ Нет": False,
            "Да": True,
            "Нет": False,
        }
        if message_text not in reminder_values:
            await reply_invalid(update, REMINDER_MENU)
            return

        global next_task_id
        draft = context.user_data.get("draft_task", {})
        task = {
            "id": next_task_id,
            "subject": draft.get("subject", ""),
            "title": draft.get("title", ""),
            "date": draft.get("date", ""),
            "deadline": draft.get("deadline", ""),
            "reminder": reminder_values[message_text],
            "completed": False,
        }
        tasks_by_user.setdefault(user_id, []).append(task)
        next_task_id += 1
        reset_input_state(context)
        await update.message.reply_text(
            "✅ Задача добавлена!\n\n" + task_line(1, task),
            reply_markup=TASKS_MENU,
        )
        return

    if mode == "edit_task_title":
        task_id = context.user_data.get("selected_task_id")
        if not isinstance(task_id, int) or not message_text:
            await reply_invalid(update, TASKS_MENU)
            return
        task = find_task(user_id, task_id)
        if task is None:
            raise ValueError("Задача не найдена")
        task["title"] = message_text
        reset_input_state(context)
        await update.message.reply_text(
            "✅ Задача изменена.\n\n" + tasks_text(user_id),
            reply_markup=TASKS_MENU,
        )
        return

    if mode == "move_task_date":
        task_id = context.user_data.get("selected_task_id")
        parsed_date = parse_task_date(message_text)
        if not isinstance(task_id, int) or not parsed_date:
            await reply_invalid(update, TASKS_MENU)
            return
        task = find_task(user_id, task_id)
        if task is None:
            raise ValueError("Задача не найдена")
        task["date"] = parsed_date
        reset_input_state(context)
        await update.message.reply_text(
            "✅ Задача перенесена.\n\n" + tasks_text(user_id),
            reply_markup=TASKS_MENU,
        )
        return

    if mode == "add_schedule":
        day = context.user_data.get("schedule_day")
        if day not in WEEKDAYS or not message_text:
            await reply_invalid(update, SCHEDULE_MENU)
            return
        schedule_by_user.setdefault(user_id, {})[day] = message_text
        reset_input_state(context)
        await update.message.reply_text(
            f"✅ Расписание на {day} сохранено.",
            reply_markup=SCHEDULE_MENU,
        )
        return

    if mode in {"choose_schedule_day", "task_select_action"}:
        await reply_invalid(
            update,
            SCHEDULE_MENU if mode == "choose_schedule_day" else TASKS_MENU,
        )
        return
    if "Главное меню" in message_text or "Меню" in message_text:
        reset_user_state(update, context)
        await update.message.reply_text(
            "🏠 Главное меню. Выберите раздел:",
            reply_markup=MENU
        )
        return
    elif "Задачи" in message_text:
        await update.message.reply_text(
            "📋 Раздел «Задачи». Выберите действие:",
            reply_markup=TASKS_MENU
        )
        return
    elif "Расписание" in message_text:
        await update.message.reply_text(
            "📚 Раздел «Расписание уроков». Выберите действие:",
            reply_markup=SCHEDULE_MENU
        )
        return
    elif "Решебник" in message_text or "ИИ" in message_text:
        context.user_data["mode"] = "solve"
        await update.message.reply_text(
            "🤖 ИИ-Решебник\nОтправь мне условие задачи или вопрос по любому предмету. Чтобы выйти из режима — нажми кнопку ниже.",
            reply_markup=MENU
        )
        return

    if mode == "solve":
        await context.bot.send_chat_action(update.message.chat.id, "typing")
        await update.message.reply_text(
            "⏳ Думаю над решением. Это может занять несколько секунд..."
        )
        cancel_ai_task(user_id)
        ai_task = asyncio.create_task(
            process_ai_request(update, context, message_text, user_id)
        )
        ai_tasks_by_user[user_id] = ai_task
        return

    await update.message.reply_text(
        "Выберите раздел с помощью кнопок ниже.",
        reply_markup=MENU,
    )


async def handle_photo(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    """Принять фото в любом режиме и запустить его обработку."""
    if not update.message or not update.message.photo:
        return

    user_id = get_user_id(update)
    if user_id is None:
        return

    try:
        reset_user_state(update, context)
        context.user_data["mode"] = "solve_photo"
        await update.message.reply_text(PHOTO_PROGRESS_TEXT)

        photo = max(
            update.message.photo,
            key=lambda item: (item.width * item.height, item.file_size or 0),
        )
        photo_task = asyncio.create_task(
            process_photo_request(update, context, photo.file_id, user_id)
        )
        ai_tasks_by_user[user_id] = photo_task
    except Exception:
        reset_user_state(update, context)
        logger.exception("Не удалось запустить обработку фото")
        await update.message.reply_text(PHOTO_ERROR_TEXT, reply_markup=MENU)


def main() -> None:
    bot_token = os.getenv("BOT_TOKEN")
    if not bot_token:
        raise RuntimeError(
            "BOT_TOKEN is missing. Add your Telegram bot token as a secret named BOT_TOKEN."
        )

    start_keep_alive_server()
    application = Application.builder().token(bot_token).build()

    # Этот обработчик зарегистрирован первым, чтобы выход не ждал другие шаги.
    application.add_handler(
        MessageHandler(filters.Regex(r"^🔙 Главное меню$"), handle_back_to_menu)
    )
    application.add_handler(CommandHandler("start", start))
    application.add_handler(CallbackQueryHandler(handle_callback))
    application.add_handler(MessageHandler(filters.PHOTO, handle_photo))
    application.add_handler(
        MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text)
    )

    print("Школьный бот запущен. Нажмите Ctrl+C, чтобы остановить его.")
    application.run_polling()


if __name__ == "__main__":
    main()
