def parse_task_date(value: str) -> str | None:
    normalized = value.strip().lower()
    today = local_today().date()
    if normalized == "сегодня":
        return today.strftime("%d.%m.%Y")
    if normalized == "завтра":
        return (today + timedelta(days=1)).strftime("%d.%m.%Y")

    for date_format in ("%d.%m.%Y", "%d-%m-%Y", "%Y-%m-%d"):
        try:
            return datetime.strptime(value.strip(), date_format).strftime("%d.%m.%Y")
        except ValueError:
            continue
    return None


def parse_deadline(value: str) -> str | None:
    match = re.fullmatch(r"([01]?\d|2[0-3]):([0-5]\d)", value.strip())
    if not match:
        return None
    return f"{int(match.group(1)):02d}:{match.group(2)}"


