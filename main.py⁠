def local_today() -> datetime:
    """Получить текущее время в часовом поясе пользователя проекта."""
    try:
        return datetime.now(ZoneInfo("Asia/Almaty"))
    except Exception:
        return datetime.now()


def schedule_day_text(user_id: int, offset: int) -> str:
    date = local_today().date() + timedelta(days=offset)
    day = ALL_WEEKDAYS[date.weekday()]
    if day == "Воскресенье":
        return f"📅 {day}, {date:%d.%m.%Y}\n\nВ этот день уроков нет"
    lessons = schedule_by_user.get(user_id, {}).get(day)
    if not lessons:
        return f"📅 {day}, {date:%d.%m.%Y}\n\nРасписание на этот день пока не заполнено"
    return f"📅 {day}, {date:%d.%m.%Y}\n\n{lessons}"


