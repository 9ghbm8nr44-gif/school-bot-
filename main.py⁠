def active_tasks(user_id: int) -> list[dict[str, object]]:
    return [
        task
        for task in tasks_by_user.get(user_id, [])
        if not task.get("completed", False)
    ]


def find_task(user_id: int, task_id: int) -> dict[str, object] | None:
    for task in tasks_by_user.get(user_id, []):
        if task.get("id") == task_id:
            return task
    return None


def task_line(number: int, task: dict[str, object]) -> str:
    reminder = "вкл." if task.get("reminder") else "выкл."
    return (
        f"{number}. {task.get('subject', 'Без предмета')}: "
        f"{task.get('title', '')}\n"
        f"   📅 {task.get('date', '')} | ⏰ {task.get('deadline', '')} "
        f"| 🔔 {reminder}"
    )


def tasks_text(user_id: int) -> str:
    """Подготовить список незавершённых задач пользователя."""
    user_tasks = active_tasks(user_id)
    if not user_tasks:
        return (
            "📋 Текущих задач пока нет.\n\n"
            "Нажмите «➕ Добавить задачу», чтобы записать новую."
        )

    lines = ["📋 Текущие задачи:", ""]
    for number, task in enumerate(user_tasks, start=1):
        lines.append(task_line(number, task))
    return "\n".join(lines)


